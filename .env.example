# Copy to .env and edit. Never commit .env.
# WRDS user name. The password is read from ~/.pgpass by the wrds library, never from here.
WRDS_USERNAME=
# Root directory for cache/, imports/ and runs/
HFTF_DATA_DIR=data
HFTF_USER_PLUGINS_DIR=user_plugins
HFTF_HOST=127.0.0.1
HFTF_PORT=8000
HFTF_FRONTEND_ORIGIN=http://127.0.0.1:5173
# Hot-reload user_plugins/ when files change
HFTF_DEV_MODE=true
HFTF_LOG_LEVEL=INFO
HFTF_DEFAULT_CALENDAR=XNYS
HFTF_MAX_WORKERS=2
HFTF_DEFAULT_BENCHMARK=SPY
