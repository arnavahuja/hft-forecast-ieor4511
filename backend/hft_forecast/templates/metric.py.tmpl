"""{title}: a user metric group."""

from __future__ import annotations

from typing import ClassVar

import numpy as np

from hft_forecast.core import Metric, MetricContext, register
from hft_forecast.core.interfaces import MetricOutput
from hft_forecast.core.specs import MetricDescriptor, MetricFormat


@register("metric", name="{name}", version="0.1.0", tags=["user"])
class {cls}(Metric):
    """Share of bars with a return above 1%."""

    descriptors: ClassVar[tuple[MetricDescriptor, ...]] = (
        MetricDescriptor(key="{name}_big_up_days", label="Bars above +1%", group="User",
                         format=MetricFormat.PERCENT, higher_is_better=True),
    )

    def compute(self, ctx: MetricContext) -> dict[str, MetricOutput]:
        """Return one value per descriptor key (``None`` when undefined)."""
        r = ctx.returns[np.isfinite(ctx.returns)]
        return {{"{name}_big_up_days": float((r > 0.01).mean()) if r.size else None}}
