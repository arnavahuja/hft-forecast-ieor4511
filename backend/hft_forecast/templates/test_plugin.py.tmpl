"""Tests for the {name} {kind} plugin (run with pytest)."""

from __future__ import annotations

from pathlib import Path

from hft_forecast.core.registry import registry
from hft_forecast.services.plugins import PluginService

PLUGIN_DIR = Path(__file__).resolve().parents[1]


def test_{name}_is_registered_and_instantiates():
    PluginService(user_dir=PLUGIN_DIR).load()
    spec = registry("{kind}").get("{name}")
    assert spec.params_schema()["type"] == "object"
    assert spec.create() is not None
